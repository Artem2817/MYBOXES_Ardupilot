# Myboxes MINI v2 hardware revision 2 bootloader.
MCU STM32H7xx STM32H743xx
APJ_BOARD_ID AP_HW_MYBOXH743_MINI_V2
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128
SERIAL_ORDER OTG1 USART2
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD
PD6 USART2_RX USART2 NODMA
PD5 USART2_TX USART2 NODMA
PE4 LED_BOOTLOADER OUTPUT HIGH
define HAL_LED_ON 0
PB12 IMU1_CS CS
PA4 IMU2_CS CS
PE11 MAX7456_CS CS
PA15 HEATER OUTPUT LOW
PD11 SENSOR_PWR_EN OUTPUT HIGH
PA8 GPIO_CAN1_SILENT OUTPUT HIGH
PD7 GPIO_CAN2_SILENT OUTPUT HIGH
define HAL_USE_EMPTY_STORAGE 1
