# MYBOX H743 Mini, current CAD 2026-11-05. AI-assisted configuration.
# Main SPI2 ICM-45686; main orientation preserved from the existing Mini.
MCU STM32H7xx STM32H743xx
APJ_BOARD_ID AP_HW_MYBOXH743_MINI_V2_VIB
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128

# TIM2 is dedicated to RCIN; TIM3 to buzzer. Keep TIM13 for the system.
STM32_ST_USE_TIMER 13
define CH_CFG_ST_RESOLUTION 16

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Main-board ICM-45686, IC9. PC2_C/PC3_C on the LQFP100 package.
PB13 SPI2_SCK SPI2
PC2 SPI2_MISO SPI2
PC3 SPI2_MOSI SPI2
PB12 IMU1_CS CS

# FFC J19: reserve and deselect the second IMU even when not populated.
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PA4 IMU2_CS CS

# AT7456E analogue OSD, MAX7456-compatible driver
PE12 SPI4_SCK SPI4
PE13 SPI4_MISO SPI4
PE14 SPI4_MOSI SPI4
PE11 MAX7456_CS CS

PD11 SENSOR_PWR_EN OUTPUT HIGH
I2C_ORDER I2C1 I2C2 I2C4
PB8 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2
PD12 I2C4_SCL I2C4
PB9 I2C4_SDA I2C4
# Keep dedicated DMA for IMU and PWM timers.
# SERIAL5 RX (disabled by default) uses interrupts; bench-check high baud rates.
NODMA I2C* USART3_RX
define STM32_I2C_USE_DMA FALSE

PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)
PC4 PRESSURE_SENS ADC1 SCALE(2)
PC5 RSSI_ADC ADC1
define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_CURR_PIN 11
# R23=20k, R24=1k: connector-to-ADC division is 21.
define HAL_BATT_VOLT_SCALE 21.0
# Existing v2 analog power-module calibration is preserved.
define HAL_BATT_CURR_SCALE 83.333
define HAL_DEFAULT_AIRSPEED_PIN 4
define BOARD_RSSI_ANA_PIN 8

# D5 sinks current through PE4: active low.
PE4 LED1 OUTPUT HIGH GPIO(91)
define HAL_GPIO_A_LED_PIN 91
define HAL_HAVE_SAFETY_SWITCH 1
PE2 LED_SAFETY OUTPUT
PE3 SAFETY_IN INPUT PULLDOWN

# USB; J13 USART2; J7 UART7; J4 GPS1; J11 GPS2; J14 USART3.
SERIAL_ORDER OTG1 USART2 UART7 USART1 UART8 USART3
PD5 USART2_TX USART2
PD6 USART2_RX USART2
PD4 USART2_RTS USART2
PD3 USART2_CTS USART2
PE8 UART7_TX UART7
PE7 UART7_RX UART7
PE9 UART7_RTS UART7
PE10 UART7_CTS UART7
PA9 USART1_TX USART1
PA10 USART1_RX USART1
PE1 UART8_TX UART8
PE0 UART8_RX UART8
# Current CAD: PD8 TX, PD9 RX; no SwapTXRX workaround.
PD8 USART3_TX USART3
PD9 USART3_RX USART3

PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
PB5 CAN2_RX CAN2
PB6 CAN2_TX CAN2
# CA-IF1051HS: separate silent pins, explicitly driven LOW.
PA8 GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(70)
PD7 GPIO_CAN2_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(71)

# Current CAD: 13 outputs; PD12 is I2C4_SCL.
PB14 TIM1_CH2N TIM1 PWM(1) GPIO(50)
PB15 TIM1_CH3N TIM1 PWM(2) GPIO(51)
PD13 TIM4_CH2 TIM4 PWM(3) GPIO(52)
PD14 TIM4_CH3 TIM4 PWM(4) GPIO(53)
PD15 TIM4_CH4 TIM4 PWM(5) GPIO(54)
PC6 TIM8_CH1 TIM8 PWM(6) GPIO(55)
PC7 TIM8_CH2 TIM8 PWM(7) GPIO(56)
PA3 TIM5_CH4 TIM5 PWM(8) GPIO(57)
PA2 TIM5_CH3 TIM5 PWM(9) GPIO(58)
PA1 TIM5_CH2 TIM5 PWM(10) GPIO(59)
PA0 TIM5_CH1 TIM5 PWM(11) GPIO(60)
PE6 TIM15_CH2 TIM15 PWM(12) GPIO(61)
PE5 TIM15_CH1 TIM15 PWM(13) GPIO(62)
PB3 TIM2_CH2 TIM2 RCININT PULLDOWN LOW

PB4 TIM3_CH1 TIM3 GPIO(77) ALARM

# PA15 drives the common heater MOSFET. Populate only the heated board resistors.
PA15 HEATER OUTPUT LOW GPIO(80)
define HAL_HEATER_GPIO_PIN 80
define HAL_HEATER_GPIO_ON 1
define HAL_HAVE_IMU_HEATER 1
define AP_HEATER_IMU_INSTANCE 1
define HAL_IMU_TEMP_DEFAULT -1

PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1
define HAL_OS_FATFS_IO 1
define HAL_BOARD_LOG_DIRECTORY "/APM/LOGS"
define HAL_BOARD_TERRAIN_DIRECTORY "/APM/TERRAIN"

define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14
DMA_PRIORITY SPI1* SPI2* TIM* SPI4* USART* UART*
DMA_NOSHARE SPI1* SPI2* TIM*

SPIDEV imu_main SPI2 DEVID1 IMU1_CS MODE3 1*MHZ 8*MHZ
SPIDEV imu_isolated SPI1 DEVID2 IMU2_CS MODE3 1*MHZ 8*MHZ
# IMU0: main ICM-45686, existing orientation.
# IMU1: isolated ICM-42670-P, temporary ROTATION_NONE requested by the user.
# Heater feedback comes from isolated IMU1; main heater resistors are DNP.
IMU Invensensev3 SPI:imu_main ROTATION_NONE
IMU Invensensev3 SPI:imu_isolated ROTATION_NONE
define HAL_DEFAULT_INS_FAST_SAMPLE 3
define HAL_EKF_IMU_MASK_DEFAULT 3
BARO SPL06 I2C:0:0x76
# Daughter SPA06-003 shares I2C1: SDO must select 0x77 (main is 0x76).
BARO SPL06 I2C:0:0x77
SPIDEV osd SPI4 DEVID4 MAX7456_CS MODE0 10*MHZ 10*MHZ

# No onboard compass; allow external compass probing.
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 1
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin
ENABLE_DFU_BOOT 1
env BUILD_ABIN True
